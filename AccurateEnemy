using UnityEngine;

public class AccurateEnemy : MonoBehaviour
{
    private Rigidbody enemyRb;
    private float speed = 4.0f;
    private GameObject player;
    public float turnSpeed = 0.03f;

    void Start()
    {
        enemyRb = GetComponent<Rigidbody>();
        player = GameObject.Find("Player");
    }

    void FixedUpdate()
    {
        Vector3 lookDirection = (player.transform.position - enemyRb.position).normalized;

        Vector3 targetVelocity = lookDirection * speed;

        enemyRb.linearVelocity = Vector3.Lerp(enemyRb.linearVelocity, targetVelocity, turnSpeed);

        if (transform.position.y < -5)
        {
            Destroy(gameObject);
        }
    }
}
