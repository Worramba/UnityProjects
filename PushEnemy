using Unity.VisualScripting;
using UnityEngine;

public class PushEnemy : MonoBehaviour
{
    private Rigidbody enemyRb;
    private float speed = 5.0f;
    private GameObject player;
 
    void Start()
    {
        enemyRb = GetComponent<Rigidbody>();
        player = GameObject.Find("Player");
    }

    void FixedUpdate()
    {
        Vector3 lookDirection = (player.transform.position - enemyRb.position).normalized;

        enemyRb.AddForce(lookDirection * speed);

        if (transform.position.y < -10)
        {
            Destroy(gameObject);
        }
    }

    void OnCollisionEnter(Collision collision)
    {
        if (collision.gameObject.GetComponent<Rigidbody>())
        {
            Rigidbody collisionRb = collision.gameObject.GetComponent<Rigidbody>();
            Vector3 awayFromEnemy = collision.gameObject.transform.position - transform.position;
            collisionRb.AddForce(awayFromEnemy * 5, ForceMode.Impulse);
        }
    }
}
